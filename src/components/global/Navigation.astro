---
import { Icon } from "astro-icon/components";

const pages = [
	{
		title: "Book a Meeting",
		url: "https://calendly.com/buzzandbee/new-meeting",
	},
];
---

<header class="fixed left-0 top-0 z-50 flex w-full items-center justify-between px-6 py-6 md:px-12 md:py-10">
	<a href="/" aria-label="Home" class="logo flex items-center gap-3">

		<span class="text-xl font-bold tracking-tight md:text-2xl">Buzz&Bee</span>
	</a>
	<nav class="flex items-center gap-6">
		{
			pages.map((page) => (
				<a
					href={page.url}
					target={page.url.startsWith("http") ? "_blank" : "_self"}
					class="book-button px-6 py-3 font-semibold uppercase tracking-widest transition-all hover:scale-105 active:scale-95"
					data-cursor-hover>
					{page.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		mix-blend-mode: difference;
	}

	.logo {
		color: #fff;
	}

	.book-button {
		background: #fff;
		color: #000;
		font-size: 0.8rem;
		border-radius: 0.5rem;
		box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
	}

	.book-button:hover {
		box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
	}

	@media (max-width: 768px) {
		.book-button {
			padding: 0.5rem 1rem;
			font-size: 0.7rem;
		}
		.logo-svg {
			width: 8rem;
		}
	}
</style>
