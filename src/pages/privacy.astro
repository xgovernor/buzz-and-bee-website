---
import PrivacyPage from "@/components/infopages/Privacy.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Privacy Policy - Buzz And Bee: Your Data Security Matters",
	description:
		"Our Privacy Policy explains how Buzz And Bee (Buzz and Bee Digital) handles your personal data with transparency and security. Learn more about our privacy practices.",
	canonical: "https://mintaka.co/privacy/",
