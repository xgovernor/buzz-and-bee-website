---
import Contact from "@/components/forms/Contact.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Contact Buzz And Bee: High-End Digital Solutions",
	description:
		"Reach out to Buzz And Bee (Buzz and Bee Digital) for expert design, development, and marketing. Let's collaborate to build something exceptional.",
	canonical: "https://buzzandbee.com/contact/",
};
---

<BaseLayout seo={seo}>
	<Contact />
</BaseLayout>
