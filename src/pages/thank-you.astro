---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Thanks from "@components/infopages/ThankYou.astro";

const seo: AstroSeoProps = {
	title: "Thank You - Buzz And Bee: Message Received",
	description:
		"Thank you for reaching out to Buzz And Bee! We have received your message and will get back to you shortly to discuss your project.",
	canonical: "https://buzzandbee.com/thank-you/",
};
---

<BaseLayout seo={seo}>
	<Thanks />
</BaseLayout>
