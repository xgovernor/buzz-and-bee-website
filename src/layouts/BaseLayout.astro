---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const shareImage = new URL("/images/meta/share.png", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "Buzz And Bee: Professional Design, Development & Marketing Solutions",
	description:
		"Buzz And Bee (Buzz and Bee Digital) specializes in high-performance web design, custom development, and strategic digital marketing to help brands stand out.",
	canonical: "https://buzzandbee.com",
	openGraph: {
		url: "https://buzzandbee.com",
		title: "Buzz And Bee: Professional Design, Development & Marketing Solutions",
		description:
			"Buzz And Bee (Buzz and Bee Digital) specializes in high-performance web design, custom development, and strategic digital marketing to help brands stand out.",
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "Buzz And Bee Social Share",
				type: "image/png",
			},
		],
		site_name: "Buzz And Bee",
	},
	twitter: {
		handle: "@buzzandbee",
		site: "@buzzandbee",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Buzz and Bee Digital",
		},
	],
};

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Buzz And Bee",
	"alternateName": "Buzz and Bee Digital",
	"url": "https://buzzandbee.com",
	"logo": "https://buzzandbee.com/logo.png",
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": "",
		"contactType": "customer service",
		"email": "buzzandbee25@gmail.com",
		"availableLanguage": "en"
	},
	"sameAs": [
		"https://www.facebook.com/share/1BubaymE49/",
		"https://www.instagram.com/buzzandbee_/",
		"https://www.linkedin.com/company/buzzandbee/",
		"https://x.com/buzzandbee",
		"https://dot9.dev",
	],
	"description": "Professional agency specializing in Design, Development, and Digital Marketing."
};

const seo = {
	...defaultSeo,
	...seoProp,
};

function cursorFollowerActive() {
	const paths = ["", "/"];
	return paths.includes(pathname);
}
---

<html lang="en">
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<slot name="head" />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
		<Footer />
	</body>
</html>
